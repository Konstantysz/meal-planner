#!/bin/sh
# Pre-commit checks on staged files. Enabled by `pnpm install` (prepare script sets core.hooksPath).
# Bypass: git commit --no-verify
# ponytail: checks the working-tree copy of staged files, not the staged snapshot; switch to lint-staged if partial staging bites.
staged=$(git diff --cached --name-only --diff-filter=ACMR)

fail() {
  echo "pre-commit: $1" >&2
  exit 1
}

code=$(printf '%s\n' "$staged" | grep -E '\.(ts|tsx|js|mjs|json|css|ya?ml)$')
if [ -n "$code" ]; then
  printf '%s\n' "$code" | xargs -d '\n' pnpm -s exec prettier --check --ignore-unknown \
    || fail "formatting. Run 'pnpm format' and re-stage."
  lintable=$(printf '%s\n' "$code" | grep -E '\.(ts|tsx|js|mjs)$')
  if [ -n "$lintable" ]; then
    printf '%s\n' "$lintable" | xargs -d '\n' pnpm -s exec eslint --no-warn-ignored \
      || fail "lint errors. Fix them (or 'pnpm lint' for the full report)."
    printf '%s\n' "$lintable" | xargs -d '\n' pnpm -s exec vitest related --run --passWithNoTests \
      || fail "tests related to the staged files failed. Run 'pnpm test' for the full report."
  fi
fi

# New src/lib exports must be tested or listed under "Not covered" in the coverage map.
if printf '%s\n' "$staged" | grep -qE '^(src/lib/|tests/|scripts/test-coverage-check\.ts$|docs/wiki/references/test-coverage\.md$)'; then
  pnpm -s coverage:check || fail "coverage:check failed. Add a test or list the function under 'Not covered'."
fi

# docs/wiki/RULES.md §9
if printf '%s\n' "$staged" | grep -qE '^(docs/wiki/|scripts/wiki-check\.ts$|\.markdownlint-cli2\.jsonc$)'; then
  pnpm -s wiki:check || fail "wiki:check failed. 'pnpm wiki:fix' auto-fixes markdown style; fix the rest by hand."
fi
